{
  "manifest_version": 3,
  "name": "Blob Video Downloader",
  "version": "1.2.7",
  "description": "Detect and download authorized MP4/HLS streams with persistent downloads, exact top-to-bottom player numbering, duplicate HLS filtering, and instant cached popup startup.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "webRequest",
    "webNavigation",
    "declarativeNetRequestWithHostAccess",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "version_name": "1.2.7 - low-memory merge fix"
}
